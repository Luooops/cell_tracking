{
  "dataset": "scripta_data",
  "data_dir": "data",
  "output_root": "outputs",
  "datasets": {
    "scripta_data": {
      "root": "data/scripta_data",
      "test_wells": ["r16c02", "r01c20", "r07c07"],
      "train_wells": ["r15c12", "r12c13", "r07c02", "r09c01", "r13c12", "r16c13", "r09c09", "r14c03"],
      "val_wells": ["r08c13", "r11c12", "r03c12", "r14c13"],
      "folds": [["r08c13", "r11c12", "r03c12", "r14c13"],
        ["r15c12", "r12c13", "r07c02", "r09c01"],
        ["r13c12", "r16c13", "r09c09", "r14c03"]]
    },
    "scripta_data_refine": {
      "root": "data/scripta_data_refine",
      "test_wells": ["r16c02", "r01c20", "r07c07"],
      "train_wells": ["r15c12", "r12c13", "r07c02", "r09c01", "r13c12", "r16c13", "r09c09", "r14c03"],
      "val_wells": ["r08c13", "r11c12", "r03c12", "r14c13"],
      "folds": [["r08c13", "r11c12", "r03c12", "r14c13"],
        ["r15c12", "r12c13", "r07c02", "r09c01"],
        ["r13c12", "r16c13", "r09c09", "r14c03"]]
    }
  },
  "models": {
    "gnn_division": {
      "weights": "models/gnn_tracking/weights",
      "test": {"gap_round": true, "div_thresh": 0.5, "record_edges": false}
    },
    "gnn_tracking": {
      "weights": "models/gnn_tracking/weights",
      "train": {"epochs": 40, "batch": 16, "lr": 0.001, "seeds": [0, 1, 2], "cv_outputs": false},
      "test": {"gap_round": true, "record_edges": false}
    },
    "trackastra": {"test": {"pretrained": "general_2d", "mode": "greedy_nodiv"}},
    "classical_tracking": {
      "test": {"max_distance": 45, "max_area_ratio": 1.8, "max_shape_ratio": 1.8,
        "max_lost": 3, "area_weight": 5, "shape_weight": 3, "iou_weight": 2,
        "n_history": 3, "gap_growth": 0.35, "deformable": true, "motion_scale": 0.5,
        "gap_close_max_gap": 0, "gap_close_max_distance": 30, "max_close_cost": 12}
    },
    "motion_tracking": {
      "train": {"epochs": 30, "width": 128, "layers": 3, "max_gap": 3,
        "distance": 60, "max_tokens": 2048, "lr": 0.0001, "seed": 42,
        "use_successor": true, "successor_weight": 0.1, "detection_dropout": 0.1,
        "geometric_augmentation": true},
      "test": {"threshold": 0.5, "max_tokens": 2048, "window_frames": 6, "visualize": true}
    }
  }
}
